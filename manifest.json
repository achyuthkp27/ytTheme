{
  "manifest_version": 3,
  "name": "ytTheme — calm YouTube",
  "short_name": "ytTheme",
  "version": "1.2.2",
  "description": "Hide Shorts, ads and noise on YouTube. Glass layout over your own wallpaper, a greeting, themes, and a sort and topic bar.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "ytTheme",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "src/options/options.html",
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "*://www.youtube.com/*",
    "https://returnyoutubedislikeapi.com/*",
    "https://sponsor.ajay.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "exclude_matches": [
        "*://www.youtube.com/embed/*",
        "*://www.youtube.com/live_chat*"
      ],
      "run_at": "document_start",
      "css": [
        "src/content/shared/design.css",
        "src/content/youtube/clean.css",
        "src/content/youtube/design.css"
      ],
      "js": [
        "src/shared/wallpapers.js",
        "src/shared/settings.js",
        "src/shared/ui.js",
        "src/content/shared/core.js",
        "src/content/shared/mood.js",
        "src/content/shared/inpage.js",
        "src/content/youtube/tokens.js",
        "src/content/youtube/clean.js",
        "src/content/youtube/filters.js",
        "src/content/youtube/calm.js",
        "src/content/youtube/sorter.js",
        "src/content/youtube/menu.js",
        "src/content/youtube/dislikes.js",
        "src/content/youtube/sidebar.js",
        "src/content/youtube/history.js",
        "src/content/youtube/player.js",
        "src/content/youtube/sponsor.js",
        "src/content/youtube/watchtime.js",
        "src/content/youtube/greeting.js"
      ]
    },
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "exclude_matches": [
        "*://www.youtube.com/embed/*",
        "*://www.youtube.com/live_chat*"
      ],
      "run_at": "document_idle",
      "world": "MAIN",
      "js": [
        "src/content/youtube/page.js"
      ]
    }
  ]
}
